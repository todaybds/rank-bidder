[Unit]
Description=Rank Bidder full cycle (measure + decide + put)
After=rank-bidder-api.service

[Service]
Type=oneshot
User=rank-bidder
WorkingDirectory=/opt/rank-bidder/decision-engine
EnvironmentFile=/opt/rank-bidder/.env
ExecStart=/opt/rank-bidder/.venv/bin/python -m rank_bidder.jobs.cycle_full
StandardOutput=journal
StandardError=journal
TimeoutStartSec=270
