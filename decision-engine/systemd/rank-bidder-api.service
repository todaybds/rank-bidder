[Unit]
Description=Rank Bidder Decision Engine FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rank-bidder
WorkingDirectory=/opt/rank-bidder/decision-engine
EnvironmentFile=/opt/rank-bidder/.env
# 2026-05-28 GCP deploy fix: venv path = workspace root /opt/rank-bidder/.venv.
# 루트 pyproject.toml의 [tool.uv.workspace] 정의로 uv sync는 member 디렉토리가 아닌
# 워크스페이스 루트에 venv를 만들어 모든 member의 deps를 공유. 첫 deploy 시 H4 fix가
# decision-engine/.venv 가정으로 잘못 박제됐던 것을 운영 실측으로 정정.
# 2026-05-27 code-review H3 fix: --proxy-headers + --forwarded-allow-ips=127.0.0.1 —
# Caddy 뒤에 있으므로 client.host = 127.0.0.1 항상 — 실제 클라이언트 IP는 X-Forwarded-For
# 헤더에서 가져와야 rate-limit/log/IP allow-list이 정확.
ExecStart=/opt/rank-bidder/.venv/bin/uvicorn rank_bidder.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
