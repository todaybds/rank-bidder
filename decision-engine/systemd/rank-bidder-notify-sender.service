[Unit]
Description=Rank Bidder notification sender (Story 6.1)
Documentation=Story 6.1 — notifications_log → SMTP/SES email
After=network-online.target rank-bidder-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=rank-bidder
WorkingDirectory=/opt/rank-bidder/decision-engine
EnvironmentFile=/opt/rank-bidder/.env
ExecStart=/opt/rank-bidder/.venv/bin/python -m rank_bidder.notify.sender
StandardOutput=journal
StandardError=journal
