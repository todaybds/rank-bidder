[Unit]
Description=Rank Bidder spend daily — Naver SA stats 어제 통계 수집
After=rank-bidder-api.service

[Service]
Type=oneshot
User=rank-bidder
WorkingDirectory=/opt/rank-bidder/decision-engine
EnvironmentFile=/opt/rank-bidder/.env
ExecStart=/opt/rank-bidder/.venv/bin/python -m rank_bidder.jobs.spend_daily
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300
