[Unit]
Description=Rank Bidder health check — VM resources + cycle failure rate
After=rank-bidder-api.service

[Service]
Type=oneshot
User=rank-bidder
WorkingDirectory=/opt/rank-bidder/decision-engine
EnvironmentFile=/opt/rank-bidder/.env
ExecStart=/opt/rank-bidder/.venv/bin/python -m rank_bidder.observability.health
StandardOutput=journal
StandardError=journal
