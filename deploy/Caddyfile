# Caddyfile — Story 4.1 (FR-25, D7·D8·D29) + Story 4.2 dashboard static 서빙 (2026-05-28).
#
# rank-bidder.duckdns.org:
#   - /api/*, /health, /docs/*, /openapi.json → uvicorn 127.0.0.1:8000 reverse proxy
#   - / 및 *.html, /static/*, /robots.txt → dashboard/public 정적 서빙 (Story 4.2)
#   - /caddy-up → Caddy 자체 응답 ("ok")
#
# Bearer 토큰 검증은 uvicorn auth.bearer 미들웨어 (Caddy는 헤더 통째 forward).
# 정적 파일은 인증 없이 누구나 접근 가능 — 단 META robots noindex + dashboard JS가
# fetch 시 인증 토큰 박제 (env.js 또는 localStorage). 토큰 노출 위험은 별도 박제.
#
# 적용 전 외부 셋업:
#   1. DuckDNS A record: rank-bidder.duckdns.org → GCP VM public IPv4.
#   2. 80/443 ingress: GCP firewall + iptables OPEN.
#   3. systemd: `sudo systemctl enable --now caddy rank-bidder-api`.
#   4. `RANKBIDDER_AUTH_TOKEN` env: /opt/rank-bidder/.env.

rank-bidder.duckdns.org {
    encode gzip zstd

    log {
        output file /var/log/caddy/rank-bidder.log {
            roll_size 10mb
            roll_keep 7
        }
        format json
    }

    # Caddy 자체 health probe (uvicorn 의존 안 함).
    handle /caddy-up {
        respond "ok" 200
    }

    # API + docs + health → uvicorn reverse proxy.
    @api path /api/* /health /docs /docs/* /openapi.json /redoc /redoc/*
    handle @api {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }

    # 그 외 (/, /index.html, /system.html, /policies.html, /static/*, /robots.txt)
    # → dashboard/public 정적 서빙 (Story 4.2).
    handle {
        root * /opt/rank-bidder/dashboard/public
        file_server
    }
}
