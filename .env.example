# Rank Bidder env vars — copy to .env (gitignored)
# Naming convention: RANKBIDDER_* (Architecture D25)
# 모든 secret은 SSM Parameter Store SecureString이 source of truth.
# 이 파일은 키 이름만 보여주는 template — 값 절대 commit 금지 (NFR-7, FR-25).

# ---- Decision Engine (Oracle VM) ----
RANKBIDDER_ENV=local                          # local | staging | prod
RANKBIDDER_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
RANKBIDDER_DB_PATH=./rank_bidder.db           # SQLite 파일 경로 (prod=/var/lib/rank-bidder/rank_bidder.db)

# ---- Naver SA API ----
RANKBIDDER_NAVER_SA_API_KEY=                  # SSM:/rank-bidder/naver/api-key
RANKBIDDER_NAVER_SA_SECRET_KEY=               # SSM:/rank-bidder/naver/secret-key
RANKBIDDER_NAVER_SA_CUSTOMER_ID=              # SSM:/rank-bidder/naver/customer-id
RANKBIDDER_NAVER_SA_BASE_URL=https://api.searchad.naver.com

# ---- AWS Lambda (SERP Measurer) ----
RANKBIDDER_LAMBDA_FUNCTION_URL=               # https://abc123.lambda-url.ap-northeast-2.on.aws/
RANKBIDDER_LAMBDA_AUTH_TOKEN=                 # SSM:/rank-bidder/lambda/auth-token

# ---- AWS (백업 + SSM) ----
RANKBIDDER_AWS_REGION=ap-northeast-2
RANKBIDDER_AWS_S3_BACKUP_BUCKET=              # 예: rank-bidder-backup-seoul

# ---- Dashboard auth (FR-25) ----
RANKBIDDER_DASHBOARD_TOKEN=                   # SSM:/rank-bidder/dashboard/bearer-token
RANKBIDDER_DASHBOARD_DOMAIN=rank-bidder.duckdns.org

# ---- Email 알림 (FR-22, FR-23) ----
RANKBIDDER_SMTP_HOST=
RANKBIDDER_SMTP_PORT=587
RANKBIDDER_SMTP_USER=
RANKBIDDER_SMTP_PASSWORD=
RANKBIDDER_ALERT_TO=                          # 운영자 이메일 주소

# ---- Claude API (Epic 5 챗 MCP transport) ----
RANKBIDDER_ANTHROPIC_API_KEY=                 # SSM:/rank-bidder/anthropic/api-key
